# Copy this file to .env.local and fill it in.
#   cp .env.example .env.local
#
# .env.local is git-ignored. Never commit real secrets.

# --- NextAuth (required) ----------------------------------------------------
# The public URL of the app. Keep the localhost value for local development.
NEXTAUTH_URL=http://localhost:3000

# Any long random string. Generate one with either of these:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=

# --- Google OAuth (required) ------------------------------------------------
# console.cloud.google.com -> APIs & Services -> Credentials
#   -> Create credentials -> OAuth client ID -> Web application
#
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://YOUR-APP.vercel.app/api/auth/callback/google   (after deploying)
#
# Enable these two APIs in the same project:
#   Google Drive API, Google Forms API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Access control (required before sharing the app) -----------------------
# Comma-separated list of Google accounts allowed to sign in.
# LEAVE BLANK ONLY WHILE TESTING: blank means ANY Google account can sign in
# and create folders in your Drive. The dashboard shows a warning while blank.
#   ADMIN_EMAILS=you@example.com,colleague@example.com
ADMIN_EMAILS=

# --- Drive (optional — leave blank) -----------------------------------------
# LEAVE THIS BLANK. On first publish the app creates a folder called
# "SkillWill Activity Calendar" in your Drive and files everything inside it.
#
# This is an override for one narrow case: a folder THIS APP created. Because
# the app uses the drive.file scope (it can only see files it made itself), a
# folder id copied from the Drive UI will not work — the app will detect that,
# warn you, and use its own folder instead.
GOOGLE_DRIVE_FOLDER_ID=

# --- AI posters (optional, NOT free) ----------------------------------------
# Leave this BLANK to keep the app completely free. The three built-in poster
# templates need no API key, render instantly and cost nothing.
#
# Setting a key from console.anthropic.com adds an extra "AI variants" button
# that generates alternative poster designs for roughly $0.02 per activity,
# billed to your Anthropic account.
ANTHROPIC_API_KEY=

# --- AI artwork from your own GPU (optional) --------------------------------
# Adds an "AI artwork" button that renders a poster background on a ComfyUI
# instance you host yourself, then draws the title, date, time, location and QR
# code on top of it. Leave both blank to hide the button.
#
# COMFY_URL is the PUBLIC address of the Caddy proxy in front of ComfyUI — the
# cloudflared tunnel URL, never ComfyUI's own port. With a quick tunnel
# (cloudflared tunnel --url http://127.0.0.1:8189) this changes every time
# cloudflared restarts, and it must be updated here and in the Vercel project
# environment variables each time. A named tunnel on your own domain is what
# makes that stop.
COMFY_URL=

# The Bearer key required by C:\comfy-proxy\Caddyfile. This is the only thing
# protecting your GPU from the internet, so:
#   * it is read ONLY by server code (lib/comfy.js) and never sent to the browser
#   * never rename this to NEXT_PUBLIC_* — that inlines it into client JavaScript
#   * to rotate it: change the string in the Caddyfile, restart caddy, then
#     update this value locally and in Vercel
COMFY_API_KEY=

# NOTE: the AI artwork feature also requires ADMIN_EMAILS above to be non-empty.
# Unlike the rest of the app, it fails closed on an empty list: a blank
# ADMIN_EMAILS means "anyone signed in" everywhere else, which would be the
# wrong default for a feature that spends time on your GPU.
